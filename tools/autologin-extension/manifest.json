{
  "manifest_version": 3,
  "name": "WalletIntel AutoLogin",
  "version": "1.1.0",
  "description": "Autonomous session keeper: detects logout on arkm.com / gmgn.ai / app.cielo.finance, restores login (step-form email+password submit / wallet reconnect), reports state via DOM marker for CDP. v1.1: arkham two-step form (email→Continue→password) auto-submitted without human touch.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://arkm.com/*",
    "https://gmgn.ai/*",
    "https://app.cielo.finance/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arkm.com/*"
      ],
      "js": [
        "common.js",
        "arkham.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "js": [
        "common.js",
        "gmgn.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.cielo.finance/*"
      ],
      "js": [
        "common.js",
        "cielo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
